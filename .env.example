# ==============================================================================
# VAIDIKRATNAM.COM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any real secrets to source control.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local SQL Database (uses local file-backed LibSQL/SQLite by default)
# For remote LibSQL/Turso: libsql://[db-name].turso.io?authToken=...
# For PostgreSQL / Supabase direct: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=file:vaidikratnam.db

# 32+ character random string for signing admin session cookies
ADMIN_SESSION_SECRET=vaidikratnam_change_this_to_a_secure_random_64_char_secret_in_prod

# ------------------------------------------------------------------------------
# 2. SUPABASE (Optional - for managed PostgreSQL & Storage in production)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-private

# ------------------------------------------------------------------------------
# 3. SHOWROOM & CONTACT SETTINGS (Configurable defaults)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME="Vaidik Ratnam"
NEXT_PUBLIC_BUSINESS_TAGLINE="The Jewellery & Ratna Studio"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"

# Leave empty if not yet configured; public site will gracefully hide WhatsApp buttons
# Format: Country code + number without plus or spaces (e.g., 919876543210)
# NEXT_PUBLIC_WHATSAPP_PHONE=

# ------------------------------------------------------------------------------
# 4. OPTIONAL NOTIFICATIONS (Leave empty until SMTP/SMS provider is contracted)
# ------------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# NOTIFICATION_EMAIL_TO=

# ------------------------------------------------------------------------------
# 5. FEATURE FLAGS
# ------------------------------------------------------------------------------
# Set to 'true' in development to inspect sample layouts. In production, keep 'false'.
ENABLE_DEMO_SEED=true

# Public consultation booking availability
ENABLE_CONSULTATION_BOOKING=true

# Wholesale catalogue is protected and hidden by default in v1
ENABLE_WHOLESALE_PORTAL=false

# ------------------------------------------------------------------------------
# 6. OPTIONAL AI KNOWLEDGE ASSISTANT (Disabled by default; does not block site)
# ------------------------------------------------------------------------------
ENABLE_AI_ASSISTANT=false
# GEMINI_API_KEY=

